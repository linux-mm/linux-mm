# Kernel configuration fragment for MM selftests

# Basic memory management
CONFIG_MMU=y
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# NUMA support
CONFIG_NUMA=y
CONFIG_NUMA_BALANCING=y

# Memory compaction
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y

# Memory control groups
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y

# userfaultfd
CONFIG_USERFAULTFD=y

# KSM
CONFIG_KSM=y

# Memory hotplug
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y

# Debug options for testing
CONFIG_DEBUG_VM=y
CONFIG_DEBUG_VM_PGTABLE=y

# GUP tests
CONFIG_GUP_TEST=m

# Additional features needed by selftests
CONFIG_SYSVIPC=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
