C limit-last-checker-nomb

(*
 * Result: Sometimes
 *
 * Like limit-last-checker, without the full barrier. Both checks can
 * miss the other addition, and both pass.
 *)

{}

P0(int *a, int *b)
{
	int r0;

	WRITE_ONCE(*a, 1);
	r0 = READ_ONCE(*b);
}

P1(int *a, int *b)
{
	int r0;

	WRITE_ONCE(*b, 1);
	r0 = READ_ONCE(*a);
}

exists (0:r0=0 /\ 1:r0=0)
